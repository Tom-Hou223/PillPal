.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #ffffff;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  -webkit-box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
          box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 1000;
}

.tab-bar-item {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  padding: 8rpx 0;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 20rpx;
  color: #999;
}

.tab-bar-item.active .tab-text {
  color: #27AE60;
  font-weight: 600;
}

.tab-bar.senior-mode {
  height: 140rpx;
}

.tab-bar.senior-mode .tab-icon {
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 8rpx;
}

.tab-bar.senior-mode .tab-text {
  font-size: 32rpx;
  font-weight: 600;
}

.tab-bar.senior-mode.theme-yellow {
  background: #000000;
}

.tab-bar.senior-mode.theme-yellow .tab-text {
  color: #FFD700;
}

.tab-bar.senior-mode.theme-yellow .tab-bar-item.active .tab-text {
  color: #FFD700;
  font-weight: bold;
}
