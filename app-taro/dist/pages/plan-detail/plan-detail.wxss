.icon-pill {
  position: relative;
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
}

.icon-pill::before {
  content: "";
  position: absolute;
  width: 24rpx;
  height: 12rpx;
  border: 3rpx solid #27ae60;
  border-radius: 12rpx 12rpx 0 0;
  top: 0;
  left: 0;
}

.icon-pill::after {
  content: "";
  position: absolute;
  width: 24rpx;
  height: 12rpx;
  border: 3rpx solid #27ae60;
  border-radius: 0 0 12rpx 12rpx;
  bottom: 0;
  left: 0;
}

