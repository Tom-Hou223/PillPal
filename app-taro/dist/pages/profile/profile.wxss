.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
  -webkit-box-sizing: border-box;
          box-sizing: border-box;
}

.avatar-section {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  margin-bottom: 60rpx;
}

.avatar-wrapper {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  gap: 24rpx;
  position: relative;
}

.avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: #f0f0f0;
  border: 4rpx solid #ffffff;
  -webkit-box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
          box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  position: relative;
  cursor: pointer;
}

.avatar-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  opacity: 0;
  -webkit-transition: opacity 0.3s ease;
  transition: opacity 0.3s ease;
  border-radius: 50%;
}

.avatar:active .avatar-mask {
  opacity: 1;
}

.avatar-mask-text {
  color: #ffffff;
  font-size: 24rpx;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  background: -webkit-linear-gradient(315deg, #f0f0f0 0%, #e0e0e0 100%);
  background: linear-gradient(135deg, #f0f0f0 0%, #e0e0e0 100%);
}

.avatar-placeholder-icon {
  font-size: 80rpx;
  line-height: 1;
}

.avatar-upload-btn {
  margin-top: 16rpx;
  background: #27AE60;
  color: #fff;
  border: none;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
}

.form-section {
  margin-bottom: 40rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  -webkit-box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
          box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.form-item {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 120rpx;
  -webkit-flex-shrink: 0;
      -ms-flex-negative: 0;
          flex-shrink: 0;
}

.form-input {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 80rpx;
  line-height: 80rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.actions {
