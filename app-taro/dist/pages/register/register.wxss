.register-container {
  min-height: 100vh;
  background: -webkit-linear-gradient(315deg, #f5f7fa 0%, #c3cfe2 100%);
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  padding: 32rpx;
  -webkit-box-sizing: border-box;
          box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 64rpx 40rpx;
  -webkit-box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
          box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
}

.card-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.login-form {
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 36rpx;
  position: relative;
}

.field-wrapper {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  border-bottom: 1rpx solid #e5e5e5;
  height: 104rpx;
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
}

.field-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  -webkit-flex-shrink: 0;
      -ms-flex-negative: 0;
          flex-shrink: 0;
}

.field-input {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  font-size: 30rpx;
  height: 104rpx;
  line-height: 104rpx;
  border: none;
  outline: none;
  background: transparent;
}

.error-message {
  font-size: 16rpx;
  color: #e74c3c;
  margin-top: 8rpx;
  margin-left: 48rpx;
}

.login-button {
  height: 100rpx;
  font-size: 34rpx;
  border-radius: 50rpx;
  background-color: #27AE60;
  color: #ffffff;
  font-weight: 600;
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
  margin-top: 16rpx;
  border: none;
  line-height: 100rpx;
  text-align: center;
}

.login-button[disabled] {
  opacity: 0.7;
}

.register-link {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

.register-link .link {
  color: #27AE60;
  margin-left: 8rpx;
  font-weight: 500;
  cursor: pointer;
}

.footer {
  text-align: center;
  padding: 0 20rpx;
  margin-top: auto;
  margin-bottom: 40rpx;
}

.footer text {
  font-size: 20rpx;
  color: #999999;
  line-height: 32rpx;
}

.footer-links {
  margin-top: 8rpx;
}

.footer .link {
  color: #27AE60;
  cursor: pointer;
}
