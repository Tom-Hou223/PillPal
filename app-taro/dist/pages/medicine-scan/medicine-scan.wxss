.scan-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* Header */

.scan-header {
  position: -webkit-sticky;
  position: sticky;
  top: 0;
  z-index: 99;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: space-between;
      -ms-flex-pack: justify;
          justify-content: space-between;
  background: #ffffff;
  padding: 24rpx 32rpx;
  padding-top: calc(24rpx + constant(safe-area-inset-top));
  padding-top: calc(24rpx + env(safe-area-inset-top));
  -webkit-box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
          box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.header-back {
  width: 60rpx;
  height: 60rpx;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
}

.back-arrow {
  font-size: 36rpx;
  color: #333333;
}

.header-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
}

.header-placeholder {
  width: 60rpx;
}

/* Main */

.scan-main {
  padding: 40rpx 32rpx;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
}

.scan-icon-area {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  margin-bottom: 48rpx;
}

.scan-icon-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: -webkit-linear-gradient(315deg, #e8f5e9, #c8e6c9);
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  margin-bottom: 24rpx;
  -webkit-box-shadow: 0 8rpx 24rpx rgba(39, 174, 96, 0.15);
          box-shadow: 0 8rpx 24rpx rgba(39, 174, 96, 0.15);
}

.scan-icon-text {
  font-size: 60rpx;
}

.scan-desc {
  font-size: 28rpx;
  color: #666666;
}

/* Loading */

.scan-loading {
  padding: 24rpx 40rpx;
  background: #fff3e0;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #f39c12;
}

/* Actions */

.scan-actions {
  width: 100%;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  gap: 24rpx;
}

.scan-action-row {
  width: 100%;
}

.scan-action-row--double {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  gap: 24rpx;
}

.scan-action-row--double .scan-btn {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
}

.scan-btn {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  padding: 32rpx 24rpx;
  border-radius: 24rpx;
  border: none;
  min-height: 160rpx;
  gap: 8rpx;
  -webkit-box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
          box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.scan-btn::after {
  border: none;
}

.scan-btn--primary {
  background: -webkit-linear-gradient(315deg, #27ae60, #2ecc71);
  background: linear-gradient(135deg, #27ae60, #2ecc71);
  color: #ffffff;
}

.scan-btn--secondary {
  background: #ffffff;
  color: #333333;
  border: 2rpx solid #e0e0e0;
}

.scan-btn--outline {
  background: #f8f9fa;
  color: #333333;
  border: 2rpx solid #e0e0e0;
}

.scan-btn-icon {
  font-size: 40rpx;
}

.scan-btn-text {
  font-size: 28rpx;
  font-weight: bold;
}

.scan-btn--primary .scan-btn-text {
  color: #ffffff;
}

.scan-btn-desc {
  font-size: 22rpx;
}

.scan-btn--primary .scan-btn-desc {
  color: rgba(255, 255, 255, 0.8);
}

.scan-btn--secondary .scan-btn-desc,
.scan-btn--outline .scan-btn-desc {
  color: #999999;
}

/* Buffer indicator */

.buffer-indicator {
  width: 100%;
  margin-top: 32rpx;
  padding: 24rpx 32rpx;
  background: #fff3e0;
  border-radius: 16rpx;
  border: 2rpx solid #f39c12;
  text-align: center;
}

.buffer-indicator-text {
  font-size: 28rpx;
  color: #f39c12;
  font-weight: bold;
}

/* Scan result */

.scan-result {
  width: 100%;
  margin-top: 32rpx;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  -webkit-box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
          box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.result-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.result-code {
  font-size: 26rpx;
  color: #666666;
  word-break: break-all;
}

.result-info {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.result-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #27ae60;
}

.result-detail {
  font-size: 24rpx;
  color: #666666;
  margin-top: 8rpx;
}

/* Modal overlay */

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  padding: 48rpx;
}

.photo-buffer-modal {
  width: 100%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
}

.modal-header {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-justify-content: space-between;
      -ms-flex-pack: justify;
          justify-content: space-between;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  padding: 32rpx;
  padding-bottom: 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

.modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #999999;
  padding: 8rpx 32rpx 24rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.photo-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f0f0f0;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
}

.photo-remove-icon {
  font-size: 20rpx;
  color: #ffffff;
}

.modal-actions {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  font-size: 26rpx;
  padding: 0;
  border: none;
}

.modal-btn::after {
  border: none;
}

.modal-btn--default {
  background: #f0f0f0;
  color: #666666;
}

.modal-btn--danger {
  background: #fce4ec;
  color: #e74c3c;
}

.modal-btn--primary {
  background: #27ae60;
  color: #ffffff;
}
