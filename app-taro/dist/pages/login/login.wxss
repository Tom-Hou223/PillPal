.login-container {
  min-height: 100vh;
  background: -webkit-linear-gradient(315deg, #f5f7fa 0%, #c3cfe2 100%);
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  padding: 32rpx;
  -webkit-box-sizing: border-box;
          box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  -webkit-box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
          box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
}

.card-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 20rpx;
  color: #666666;
}

.login-tabs {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid #e5e5e5;
}

.tab {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #666666;
  cursor: pointer;
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
  position: relative;
}

.login-form {
  margin-bottom: 32rpx;
}

.form-group {
  margin-bottom: 28rpx;
  position: relative;
}

.field-wrapper {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  border-bottom: 1rpx solid #e5e5e5;
  height: 104rpx;
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
}

.field-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
  -webkit-flex-shrink: 0;
      -ms-flex-negative: 0;
          flex-shrink: 0;
}

.field-icon-right {
  font-size: 28rpx;
  margin-left: 16rpx;
  -webkit-flex-shrink: 0;
      -ms-flex-negative: 0;
          flex-shrink: 0;
  cursor: pointer;
}

.field-input {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  font-size: 30rpx;
  height: 104rpx;
  line-height: 104rpx;
  border: none;
  outline: none;
  background: transparent;
}

.error-message {
  font-size: 16rpx;
  color: #e74c3c;
  margin-top: 8rpx;
  margin-left: 48rpx;
}

.form-footer {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-justify-content: space-between;
      -ms-flex-pack: justify;
          justify-content: space-between;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  margin: 16rpx 0 24rpx;
}

.remember-me {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  font-size: 22rpx;
  color: #666666;
}

.remember-text {
  font-size: 22rpx;
  color: #666666;
  margin-left: 8rpx;
}

.forgot-password {
  font-size: 22rpx;
  color: #27AE60;
  cursor: pointer;
}

.login-button {
  height: 100rpx;
  font-size: 34rpx;
  border-radius: 50rpx;
  background-color: #27AE60;
  color: #ffffff;
  font-weight: 600;
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
  margin-top: 16rpx;
  border: none;
  line-height: 100rpx;
  text-align: center;
}

.login-button[disabled] {
  opacity: 0.7;
}

.divider {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  margin: 32rpx 0;
  position: relative;
}

.divider::before {
  content: "";
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  height: 1rpx;
  background-color: #e5e5e5;
}

.divider::after {
  content: "";
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  height: 1rpx;
  background-color: #e5e5e5;
}

.divider text {
  padding: 0 20rpx;
  font-size: 20rpx;
  color: #999999;
  background-color: #ffffff;
}

.button-group {
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.action-button {
  -webkit-flex: 1;
      -ms-flex: 1;
          flex: 1;
  border-radius: 50rpx;
  padding: 24rpx;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-align-items: center;
      -ms-flex-align: center;
          align-items: center;
  -webkit-justify-content: center;
      -ms-flex-pack: center;
          justify-content: center;
  -webkit-transition: all 0.3s ease;
  transition: all 0.3s ease;
  position: relative;
}

.action-button text {
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 10rpx;
}

.btn-icon {
  font-size: 24rpx;
  margin-left: 0 !important;
}

/* WeChat login button */

.wechat-login {
  border: 2rpx solid #27AE60;
  background-color: #ffffff;
  color: #27AE60;
}

/* Register button */

.register-button {
  border: 2rpx solid #27AE60;
  background-color: #ffffff;
  color: #27AE60;
}

/* Guest mode button */

.guest-button {
  border: 2rpx solid #e5e5e5;
  background-color: #ffffff;
  -webkit-flex-direction: column;
      -ms-flex-direction: column;
          flex-direction: column;
}

.guest-button .guest-desc {
  font-size: 20rpx;
  color: #999999;
  margin-left: 0 !important;
  margin-top: 8rpx;
}

.footer {
  text-align: center;
  padding: 0 20rpx;
  margin-top: 24rpx;
  margin-bottom: 16rpx;
}

.footer text {
  font-size: 20rpx;
  color: #999999;
  line-height: 32rpx;
}

.footer .link {
  color: #27AE60;
  cursor: pointer;
}
