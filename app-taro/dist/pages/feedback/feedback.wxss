  top: 0;
  left: 0;
  right: 0;
  width: 100%;
  background: #ffffff;
  -webkit-box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
          box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
  z-index: 1000;
  height: calc(0rpx + 88rpx);
  padding-top: 0rpx;
  -webkit-box-sizing: border-box;
          box-sizing: border-box;
  display: -webkit-flex;
