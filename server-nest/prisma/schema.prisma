generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                   BigInt                   @id
  openid               String                   @unique(map: "openid") @db.VarChar(100)
  phone                String?                  @unique(map: "phone") @db.VarChar(20)
  password             String?                  @db.VarChar(255)
  nickname             String?                  @db.VarChar(100)
  avatarUrl            String?                  @map("avatar_url") @db.VarChar(500)
  createdAt            DateTime?                @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt            DateTime?                @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  createdFamilies      Family[]                 @relation("UserCreatedFamilies")
  familyUserRoles      FamilyUserRole[]
  recognitionHistories RecognitionHistory[]
  refreshTokens        RefreshToken[]
  notificationSettings UserNotificationSetting?
  userSubscriptions    UserSubscription[]

  @@index([openid], map: "idx_users_openid")
  @@index([phone], map: "idx_users_phone")
  @@map("users")
}

model Family {
  id                   BigInt               @id
  name                 String               @db.VarChar(100)
  creatorId            BigInt               @map("creator_id")
  inviteCode           String?              @unique(map: "invite_code") @map("invite_code") @db.VarChar(20)
  inviteCodeExpiresAt  DateTime?            @map("invite_code_expires_at") @db.DateTime(0)
  createdAt            DateTime?            @default(now()) @map("created_at") @db.DateTime(0)
  creator              User                 @relation("UserCreatedFamilies", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "families_ibfk_1")
  familyMembers        FamilyMember[]
  familyUserRoles      FamilyUserRole[]
  medicines            Medicine[]
  plans                Plan[]
  recognitionHistories RecognitionHistory[]
  records              Record[]

  @@index([creatorId], map: "creator_id")
  @@index([inviteCode], map: "idx_families_invite_code")
  @@map("families")
}

model FamilyUserRole {
  id           BigInt      @id
  familyId     BigInt      @map("family_id")
  userId       BigInt      @map("user_id")
  role         FamilyRole? @default(member)
  relationship String?     @default("member") @db.VarChar(50)
  joinedAt     DateTime?   @default(now()) @map("joined_at") @db.DateTime(0)
  family       Family      @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_user_roles_ibfk_1")
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_user_roles_ibfk_2")

  @@unique([familyId, userId], map: "unique_family_user")
  @@index([familyId], map: "idx_family_user_roles_family")
  @@index([userId], map: "idx_family_user_roles_user")
  @@map("family_user_roles")
}

model FamilyRelationshipRule {
  id           Int     @id @default(autoincrement())
  relationship String  @unique(map: "relationship") @db.VarChar(50)
  maxCount     Int?    @map("max_count")
  description  String? @db.VarChar(200)

  @@map("family_relationship_rules")
}

model FamilyMember {
  id           BigInt    @id
  familyId     BigInt?   @map("family_id")
  name         String    @db.VarChar(100)
  relationship String?   @db.VarChar(50)
  age          Int?
  createdAt    DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  family       Family?   @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_members_ibfk_1")

  @@index([familyId], map: "idx_family_members_family_id")
  @@map("family_members")
}

model Medicine {
  id            BigInt    @id
  familyId      BigInt?   @map("family_id")
  name          String    @db.VarChar(255)
  manufacturer  String?   @db.VarChar(255)
  specification String?   @db.VarChar(255)
  category      String?   @db.VarChar(100)
  stock         Int?      @default(0)
  unit          String?   @db.VarChar(50)
  expiryDate    DateTime? @map("expiry_date") @db.Date
  dosage        String?   @db.Text
  createdAt     DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  family        Family?   @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "medicines_ibfk_1")

  @@index([familyId], map: "idx_medicines_family_id")
  @@map("medicines")
}

model Plan {
  id           BigInt    @id
  familyId     BigInt?   @map("family_id")
  medicineName String    @map("medicine_name") @db.VarChar(255)
  memberName   String    @map("member_name") @db.VarChar(100)
  frequency    String?   @db.VarChar(50)
  timeSlots    Json?     @map("time_slots")
  status       String?   @default("active") @db.VarChar(20)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  createdAt    DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  family       Family?   @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "plans_ibfk_1")
  records      Record[]

  @@index([familyId], map: "idx_plans_family_id")
  @@index([status], map: "idx_plans_status")
  @@map("plans")
}

model Record {
  id           BigInt    @id
  familyId     BigInt?   @map("family_id")
  planId       BigInt?   @map("plan_id")
  medicineName String    @map("medicine_name") @db.VarChar(255)
  memberName   String    @map("member_name") @db.VarChar(100)
  time         String?   @db.VarChar(10)
  date         DateTime? @db.Date
  status       String?   @default("pending") @db.VarChar(20)
  createdAt    DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  plan         Plan?     @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "records_ibfk_1")
  family       Family?   @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "records_ibfk_2")

  @@index([date], map: "idx_records_date")
  @@index([familyId], map: "idx_records_family_id")
  @@index([status], map: "idx_records_status")
  @@index([planId], map: "plan_id")
  @@map("records")
}

model UserSubscription {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  templateId   String    @map("template_id") @db.VarChar(100)
  templateType String    @map("template_type") @db.VarChar(20)
  isActive     Boolean?  @default(true) @map("is_active")
  subscribedAt DateTime? @default(now()) @map("subscribed_at") @db.DateTime(0)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_subscriptions_ibfk_1")

  @@unique([userId, templateType], map: "unique_user_template")
  @@index([templateType], map: "idx_template_type")
  @@index([userId], map: "idx_user_id")
  @@map("user_subscriptions")
}

model UserNotificationSetting {
  id                BigInt    @id @default(autoincrement())
  userId            BigInt    @unique(map: "user_id") @map("user_id")
  reminderTime      Int?      @default(15) @map("reminder_time")
  expiryWarningDays Int?      @default(30) @map("expiry_warning_days")
  createdAt         DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_notification_settings_ibfk_1")

  @@index([userId], map: "idx_user_id")
  @@map("user_notification_settings")
}

model RecognitionHistory {
  id                BigInt          @id @default(autoincrement())
  userId            BigInt          @map("user_id")
  familyId          BigInt          @map("family_id")
  type              RecognitionType
  inputData         String?         @map("input_data") @db.Text
  recognitionResult Json?           @map("recognition_result")
  isAdded           Boolean?        @default(false) @map("is_added")
  createdAt         DateTime?       @default(now()) @map("created_at") @db.DateTime(0)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recognition_history_ibfk_1")
  family            Family          @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recognition_history_ibfk_2")

  @@index([familyId], map: "family_id")
  @@index([userId, createdAt], map: "idx_user_created")
  @@map("recognition_history")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  token     String   @db.VarChar(500)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

enum FamilyRole {
  admin
  member
}

enum RecognitionType {
  barcode
  image
}
